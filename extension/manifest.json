{
  "manifest_version": 3,
  "name": "SCMix Pro",
  "version": "0.1.0",
  "description": "AutoDJ mixer concept with Zoom musician audio routing",
  "icons": {
    "16": "icons/icon-16.svg",
    "48": "icons/icon-48.svg",
    "128": "icons/icon-128.svg"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabCapture"
  ],
  "host_permissions": [
    "https://soundcloud.com/*",
    "https://w.soundcloud.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SCMix Pro"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
